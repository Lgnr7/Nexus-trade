# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=3000
# Répertoire de persistance (positions, historique, réglages).
DATA_DIR=./data

# Protège l'interface par mot de passe (laisser vide = accès libre).
# Fortement recommandé si le bot tourne en mode LIVE.
DASHBOARD_PASSWORD=

# ─── Kraken ─────────────────────────────────────────────────────────────────
KRAKEN_KEY=
KRAKEN_SECRET=

# Garde-fou : le mode LIVE (argent réel) est refusé tant que ce n'est pas "true".
# Le dashboard ne peut pas l'activer tout seul.
ALLOW_LIVE_TRADING=false

# ─── Solana ─────────────────────────────────────────────────────────────────
# Clé privée du wallet (format bs58, ~88 caractères). Sans elle, le sniper
# tourne en lecture seule (scan + scoring, aucun achat).
SOLANA_PRIVATE_KEY=
# RPC custom (Helius / QuickNode…). Défaut : RPC public mainnet (lent).
SOLANA_RPC=
# Wallets "smart money" à suivre, séparés par des virgules.
SMART_WALLETS=
# Adresses de dev blacklistées, séparées par des virgules.
DEV_BLACKLIST=

# ─── Alertes ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
