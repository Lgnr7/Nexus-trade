# Copiez ce fichier en .env pour lancer la boutique en local.

PORT=3100
# Adresse publique du site (sert aux retours depuis Stripe).
PUBLIC_URL=http://localhost:3100

# ── Stripe ── https://dashboard.stripe.com/apikeys
# Sans clé : mode démonstration (aucun paiement).
# sk_test_… : mode test (carte 4242 4242 4242 4242).
# sk_live_… : paiements réels.
STRIPE_SECRET_KEY=
# Développeurs → Webhooks → endpoint <PUBLIC_URL>/api/stripe/webhook,
# événement checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# ── Livraison (montants en centimes) ──
FREE_SHIPPING_FROM=4900
SHIPPING_COST=490
DELIVERY_MIN_DAYS=6
DELIVERY_MAX_DAYS=12
SHIP_COUNTRIES=FR,BE,LU,MC

# ── Informations légales (obligatoires avant d'ouvrir) ──
SHOP_NAME=Ronron
SHOP_OWNER=
SHOP_ADDRESS=
SHOP_SIRET=
SHOP_EMAIL=
SHOP_MEDIATOR=
# SHOP_VAT_NOTE=TVA non applicable, art. 293 B du CGI
